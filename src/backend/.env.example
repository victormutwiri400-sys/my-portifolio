# Portfolio Backend Configuration
# Copy this to .env and update with your values

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# File Upload Settings (in MB)
MAX_UPLOAD_SIZE=50

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Allowed File Extensions
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp

# Admin security - protect all write operations (POST/PUT/DELETE).
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Cloudinary image storage (required for uploads on Vercel/Render read-only disks)
# Get these from https://console.cloudinary.com -> Account Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
